# Copy this file to .env.local (gitignored) for local dev, and add the same keys
# as GitHub Actions repo secrets (Settings → Secrets and variables → Actions) for
# the deployed build. Both VITE_* values are embedded in the client bundle at
# build time, so treat them as PUBLISHABLE, not secret — Supabase Row Level
# Security is what actually protects the data.

# ── Supabase (required — sign-in is disabled without these) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON=your-public-anon-key

# ── Email ──
# Email is sent server-side by the `send-email` Supabase Edge Function — there are
# NO EmailJS keys in the client. Configure the function's secrets with the Supabase
# CLI instead (see supabase/functions/send-email/README.md):
#   supabase secrets set EMAILJS_SERVICE=... EMAILJS_TEMPLATE_ORDER=... \
#     EMAILJS_TEMPLATE_APPROVAL=... EMAILJS_PUBLIC_KEY=... EMAILJS_PRIVATE_KEY=...
