# Copy this file to .env.local (gitignored) for local dev, and add the same keys
# as GitHub Actions repo secrets (Settings → Secrets and variables → Actions) for
# the deployed build. Every VITE_* value is embedded in the client bundle at build
# time, so treat them as PUBLISHABLE, not secret — protect them via the provider
# dashboards (Supabase Row Level Security, EmailJS allowed-origins + rate limits),
# not by trying to hide them.

# ── Supabase (required — sign-in is disabled without these) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON=your-public-anon-key

# ── EmailJS (optional — booking/approval emails are skipped if unset) ──
VITE_EMAILJS_SERVICE=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ORDER=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_APPROVAL=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
