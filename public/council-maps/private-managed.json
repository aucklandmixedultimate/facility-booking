{
  "_about": "Council-owned (or council-bookable) sports grounds where a private operator — a club, trust or council CCO — controls or sub-allocates the fields. Requests go through the operator first. Scope: the default Auckland view, North Harbour Stadium to Opaheke Sports Park. Researched 2026-09-30 from operators' public web pages; 'status' says how sure we are that the operator manages field use. Verify before relying on a contact.",
  "workflow": [
    {
      "key": "permission",
      "label": "Get the private operator's permission",
      "detail": "Ask the operator for the field, day and time. Get the yes in writing (email)."
    },
    {
      "key": "apply",
      "label": "Apply to Auckland Council",
      "detail": "Submit the council booking application for the same slot. Note the operator's permission in the application."
    },
    {
      "key": "wait",
      "label": "Wait for council approval",
      "detail": "Wait for the council decision email from parksbookings@news.aucklandcouncil.govt.nz."
    },
    {
      "key": "confirm",
      "label": "Confirm with the private operator",
      "detail": "Send the operator the council confirmation and lock in the slot, lights and access (keys, gates, changing rooms)."
    }
  ],
  "statuses": {
    "confirmed": "The operator states that it takes field bookings, or AMUA has confirmed it",
    "likely": "The operator has a field-bookings or hire page for this ground",
    "to-verify": "Resident club with clubrooms and a seasonal allocation; ask whether it sub-allocates"
  },
